@page "/login"

@using QuiniegolController
@using QuiniegolModels
@using QuiniegolWeb.Services

@rendermode InteractiveServer

@inject SesionService Session
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión - Quiniegol</PageTitle>

<div class="login-container">

    <div class="login-card">

        <h1>Quiniegol</h1>

        <h3>Iniciar sesión</h3>

        <div class="form-group">
            <label>Usuario</label>

            <input class="form-control"
                   @bind="nombre"
                   placeholder="Ingrese su nombre" />
        </div>

        <div class="form-group">
            <label>Contraseña</label>

            <input class="form-control"
                   type="password"
                   @bind="contrasena"
                   placeholder="Ingrese su contraseña" />
        </div>

        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <div class="alert alert-danger">
                @mensaje
            </div>
        }

        <button class="btn btn-primary w-100"
                @onclick="IniciarSesion">
            Iniciar sesión
        </button>

        <div class="text-center mt-3">

            <p class="mb-2">
                ¿No tiene una cuenta?
            </p>

            <button class="btn btn-outline-success w-100"
                    @onclick="IrARegistro">
                Registrarse
            </button>

        </div>

    </div>

</div>

@code {

    private string nombre = string.Empty;
    private string contrasena = string.Empty;
    private string mensaje = string.Empty;


    private void IniciarSesion()
    {
        mensaje = string.Empty;

        if (string.IsNullOrWhiteSpace(nombre) ||
            string.IsNullOrWhiteSpace(contrasena))
        {
            mensaje =
                "Debe ingresar usuario y contraseña.";

            return;
        }

        // Creamos el manejador de archivos.
        var dataHandler =
            new FileHandler<Usuario>();

        // Creamos el controlador de usuarios.
        var usuarioController =
            new UsuarioController(dataHandler);

        // Ubicamos el archivo Usuarios.csv.
        var archivoUsuarios = Path.Combine(
            AppContext.BaseDirectory,
            "..",
            "..",
            "..",
            "..",
            "Quiniegol",
            "Data",
            "Usuarios.csv");

        archivoUsuarios =
            Path.GetFullPath(archivoUsuarios);

        // Cargamos los usuarios existentes.
        usuarioController.Load(
            archivoUsuarios);

        // Autenticamos utilizando UsuarioController.
        Usuario usuario =
            usuarioController.AuthenticateUser(
                nombre,
                contrasena);

        if (usuario == null)
        {
            mensaje =
                "Usuario, contraseña incorrectos o usuario desactivado.";

            return;
        }

        // Guardamos el usuario autenticado en la sesión.
        Session.IniciarSesion(usuario);

        // Redirección según el rol.
        if (usuario.Rol == "Administrador")
        {
            Navigation.NavigateTo("/admin");
        }
        else
        {
            Navigation.NavigateTo("/dashboard");
        }
    }


    private void IrARegistro()
    {
        Navigation.NavigateTo("/registro");
    }
}